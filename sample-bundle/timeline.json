[
  { "t": 0,     "kind": "nav",     "url": "https://admin.acme.example.com/login" },
  { "t": 1200,  "kind": "speech",  "text": "Okay, I'm going to walk through how we issue a refund for a customer who received a damaged item." },
  { "t": 2500,  "kind": "click",   "selector": "#email", "label": "Email", "frame": "frames/0000002500.png" },
  { "t": 3400,  "kind": "input",   "selector": "#email", "value": "‹redacted:email›" },
  { "t": 4200,  "kind": "input",   "selector": "#password", "value": "‹redacted:secret›" },
  { "t": 5000,  "kind": "click",   "selector": "button[type=submit]", "label": "Sign in" },
  { "t": 5200,  "kind": "network", "method": "POST", "url": "/api/auth/login", "status": 200, "ms": 240 },
  { "t": 6800,  "kind": "nav",     "url": "https://admin.acme.example.com/dashboard" },
  { "t": 8000,  "kind": "speech",  "text": "Now I search for the customer by their order ID. We always start from the order, never the customer record." },
  { "t": 9500,  "kind": "click",   "selector": "#order-search", "label": "Search orders" },
  { "t": 10300, "kind": "input",   "selector": "#order-search", "value": "ORD-48213" },
  { "t": 11000, "kind": "key",     "key": "Enter" },
  { "t": 11200, "kind": "network", "method": "GET", "url": "/api/orders?q=ORD-48213", "status": 200, "ms": 180 },
  { "t": 12500, "kind": "nav",     "url": "https://admin.acme.example.com/orders/ORD-48213" },
  { "t": 14000, "kind": "speech",  "text": "I verify the order total and check the eligibility badge — refunds only allowed within 30 days.", "frame": "frames/0000016000.png" },
  { "t": 16000, "kind": "click",   "selector": "#issue-refund", "label": "Issue refund" },
  { "t": 17000, "kind": "speech",  "text": "I select a full refund and add a reason so the finance team has context." },
  { "t": 18000, "kind": "click",   "selector": "input[name=refund-type][value=full]", "label": "Full refund" },
  { "t": 19500, "kind": "input",   "selector": "#refund-reason", "value": "Customer received damaged item" },
  { "t": 21000, "kind": "click",   "selector": "#confirm-refund", "label": "Confirm refund", "frame": "frames/0000021000.png" },
  { "t": 21200, "kind": "network", "method": "POST", "url": "/api/orders/ORD-48213/refund", "status": 200, "ms": 310, "request_body": { "amount": "full", "reason": "Customer received damaged item" } },
  { "t": 22500, "kind": "nav",     "url": "https://admin.acme.example.com/orders/ORD-48213?refunded=1" },
  { "t": 23500, "kind": "speech",  "text": "And that's it — the customer gets an email confirmation automatically, no extra step needed." }
]
